# --- EXECUTION ROUTING ---
# Options: "offline" (Local RapidOCR/Ollama), "online" (Cloud VLM API), "agent" (Antigravity/Claude/GHCP)
APP_MODE=agent

# --- HOTKEYS ---
HOTKEY_SCAN_ROSTER=F9
HOTKEY_SCAN_BAG=F10
HOTKEY_CALIBRATE=F8
HOTKEY_ABORT=F12

# --- ROSTER SCANNING SCOPE ---
ROSTER_COUNT=9
SCAN_WEAPONS=true
SCAN_ECHOES=true
SCAN_FORTE=true
SCAN_SEQUENCES=false

# --- BACKPACK ECHO SCANNING SCOPE ---
MAX_BAG_ECHOS=50
STOP_ON_PLUS_ZERO=true
BAG_GRID_COLS=6
BAG_VISIBLE_ROWS=4

# --- DISPLAY & TIMING ---
GAME_MONITOR=1
ASPECT_RATIO=16:9
BASE_CLICK_DELAY_MS=750
JITTER_MS=150
PIXEL_JITTER=3
WAIT_FOR_GAME_EXIT=true

# --- ONLINE VLM CONFIG ---
# Provide GEMINI_API_KEY in your shell environment or .env.local (never commit secrets)
GEMINI_MODEL=gemini-2.5-flash
